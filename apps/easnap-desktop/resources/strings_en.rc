// Easnap - user-visible text, English (United States).
//
// %1 ... %9 are replaced at run time. strings_tr.rc must define the same
// identifiers with the same placeholders.
#pragma code_page(65001)

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_MODE_SCREENSHOT "Screenshot"
    IDS_MODE_SCROLLSHOT "Scrollshot"
    IDS_MODE_RECORD "Record"
    IDS_MODE_SCROLLSHOT_UNSUPPORTED "Scrollshot needs Windows 10 version 2004 or later"
    IDS_NOTICE_COPIED "Copied to clipboard"
    IDS_DOCUMENT_VIEW_LABEL "%1 × %2   %3%%"

    IDS_SCROLLSHOT_START "Start Scrollshot"
    IDS_SCROLLSHOT_HELP "Tips for scrolling screenshots"
    IDS_SCROLLSHOT_HELP_TITLE "Scrolling screenshot"
    IDS_SCROLLSHOT_HELP_BODY "Easnap joins everything that passes through the frame into one tall image.\n\n- Press Start, then scroll the content inside the frame with the wheel, the keyboard or its scrollbar.\n- Scroll at a steady pace. If Easnap loses track, scroll back up a little and continue.\n- A fixed header or footer is kept once. The mouse pointer is never part of the image.\n- Finish with Copy (Enter or Ctrl+C), Save (Ctrl+S) or Edit. Esc discards.\n- The shortcuts work while Easnap has the keyboard focus; the capture shortcut brings it back."
    IDS_SCROLLSHOT_HELP_WHEEL "\n\nOn this computer Windows sends the wheel to the active window only. Click inside the frame once before scrolling, or turn on ""Scroll inactive windows when I hover over them"" in the Windows mouse settings."
    IDS_SCROLLSHOT_TOOL "Scrolling screenshot"
    IDS_SCROLLSHOT_TOOL_FIXED "Scrolling screenshot (not available once the screenshot is taken)"
    IDS_SCROLLSHOT_EDIT "Edit"
    IDS_SCROLLSHOT_SAVE "Save (Ctrl+S)"
    IDS_SCROLLSHOT_DISCARD "Discard (Esc)"
    IDS_SCROLLSHOT_COPY "Copy to clipboard (Enter)"
    IDS_SCROLLSHOT_SIZE "%1 × %2"
    IDS_SCROLLSHOT_STATUS_SCROLL "Scroll the content inside the frame."
    IDS_SCROLLSHOT_STATUS_LOST "Easnap lost track. Scroll back up a little, then continue."
    IDS_SCROLLSHOT_STATUS_LIMIT "Maximum length reached. Copy, save or edit the image."
    IDS_SCROLLSHOT_STATUS_CAPTURE_FAILED "This area cannot be captured any more. What was captured is kept."
    IDS_SCROLLSHOT_STATUS_DISPLAY_CHANGED "The display changed, so capture stopped. Your image is kept."
    IDS_SCROLLSHOT_STATUS_WHEEL "The wheel goes to the active window. Click inside the frame once, then scroll."
    IDS_SCROLLSHOT_STATUS_STOPPING "Still finishing the capture. Try again in a moment."
    IDS_SCROLLSHOT_STATUS_COPY_FAILED "The clipboard did not accept the image. Use Save."
    IDS_SCROLLSHOT_STATUS_SAVE_FAILED "Save failed. The image is still here; try another location."
    IDS_SCROLLSHOT_STATUS_READY "Capture stopped. Copy, save or edit the image."
    IDS_SCROLLSHOT_START_FAILED "Easnap could not capture this area. Try again."
    IDS_SCROLLSHOT_UNSUPPORTED "Scrolling screenshots need Windows 10 version 2004 or later, because Easnap must keep its own windows out of the captured image."
    IDS_SCROLLSHOT_PANEL_TITLE "Easnap - Scrollshot"
    IDS_SCROLLSHOT_PREVIEW_TITLE "Scrollshot preview"
    IDS_SCROLLSHOT_STATUS_COPYING "Copying..."
    IDS_SCROLLSHOT_STATUS_SAVING "Saving..."

    IDS_DIALOG_YES "Yes"
    IDS_DIALOG_NO "No"
    IDS_DIALOG_OK "OK"
    IDS_DIALOG_CANCEL "Cancel"
    IDS_EXIT_TITLE "Exit Easnap"
    IDS_EXIT_RECORDING "A recording is in progress.\n\nIf you exit now, the recording is discarded."
    IDS_EXIT_UNSAVED_RECORDING "This recording has not been saved or copied.\n\nIf you exit now, it is deleted."
    IDS_EXIT_EXPORT "A recording is being exported.\n\nIf you exit now, the export is cancelled and the recording is deleted."
    IDS_EXIT_IMAGE "This image has not been copied or saved.\n\nIf you exit now, it is lost."
    IDS_EXIT_CONFIRM "Exit anyway"
    IDS_EXIT_STAY "Stay"
    IDS_SHUTDOWN_REASON_RECORDING "A recording is in progress and would be lost."
    IDS_SHUTDOWN_REASON_UNSAVED "A recording has not been saved yet."
    IDS_SHUTDOWN_REASON_IMAGE "An image has not been copied or saved yet."
    IDS_DISCARD_IMAGE_TITLE "Discard screenshot"
    IDS_DISCARD_IMAGE_TEXT "Discard this screenshot?\n\nWhat you drew on it will be lost."
    IDS_DISCARD_SCROLLSHOT_TEXT "Discard this scrolling screenshot?\n\nThe captured image will be lost."
    IDS_DISCARD_CONFIRM "Discard"
    IDS_DISCARD_KEEP "Keep"
    IDS_DISCARD_RECORDING_TITLE "Discard recording"
    IDS_DISCARD_RECORDING_TEXT "Discard this recording?\n\nThe unsaved recording and its temporary trim data will be permanently deleted."
    IDS_DISCARD_RECORDING_KEEP "Keep recording"
    IDS_CRASH_TITLE "Easnap closed unexpectedly"
    IDS_CRASH_TEXT "Easnap closed unexpectedly the last time it ran.\n\nA crash report was saved on this computer. Nothing has been sent anywhere. If you report the problem, you can attach the newest file in the folder.\n\nOpen the folder?"
    IDS_CRASH_OPEN "Open folder"
    IDS_NOT_NOW "Not now"
    IDS_RECOVERY_TITLE "Unsaved recording"
    IDS_RECOVERY_TEXT "Easnap found a recording from %1 (%2 MB) that had not been saved when Easnap closed.\n\nYou can save it now as an MP4 file."
    IDS_RECOVERY_SAVE "Save..."
    IDS_RECOVERY_DELETE "Delete"
    IDS_RECOVERY_SAVE_FAILED "The recording could not be saved there. It is kept, and Easnap will offer it again the next time it starts."
    IDS_RECORDING_KEPT_FOR_RECOVERY "Easnap could not open the trim view.\n\nThe recording is kept. Easnap will offer to save it the next time it starts."
    IDS_RECORDING_UNFINISHED "Easnap could not complete the recording."
    IDS_RECORDING_UNFINISHED_KEPT "The unfinished file is kept until Easnap exits:\n%1"
    IDS_RECORD_START_FAILED "Could not start recording."
    IDS_RECORD_START_AUDIO "The audio source could not be opened. Check the device, or record without audio."
    IDS_RECORD_START_ENCODER "The video encoder on this computer did not accept this region. Try a smaller one."
    IDS_RECORD_START_STORAGE "Easnap could not write to its temporary folder. Check the free disk space."
    IDS_RECORD_START_CAPTURE "This part of the screen could not be captured."
    IDS_RECORD_START_INTERNAL "The log file in Easnap's data folder has the details."
    IDS_RECORD_REGION_TOO_LARGE "This region (%1 × %2) is larger than H.264 video allows. Choose a smaller one."
END
