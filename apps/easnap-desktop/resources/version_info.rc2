// Shared by the application and its preview helper.
#if EASNAP_VERSION_IS_PRERELEASE
#define EASNAP_PRERELEASE_FLAG VS_FF_PRERELEASE
#else
#define EASNAP_PRERELEASE_FLAG 0x0L
#endif

VS_VERSION_INFO VERSIONINFO
    FILEVERSION EASNAP_VERSION_MAJOR, EASNAP_VERSION_MINOR, EASNAP_VERSION_PATCH, EASNAP_VERSION_BUILD
    PRODUCTVERSION EASNAP_VERSION_MAJOR, EASNAP_VERSION_MINOR, EASNAP_VERSION_PATCH, EASNAP_VERSION_BUILD
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG | EASNAP_PRERELEASE_FLAG
#else
    FILEFLAGS EASNAP_PRERELEASE_FLAG
#endif
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Easnap Project"
            VALUE "FileDescription", EASNAP_FILE_DESCRIPTION
            VALUE "FileVersion", EASNAP_FILE_VERSION_STRING
            VALUE "InternalName", EASNAP_INTERNAL_NAME
            VALUE "LegalCopyright", "MIT License. Copyright (c) 2026 Easnap Project."
            VALUE "OriginalFilename", EASNAP_ORIGINAL_FILENAME
            VALUE "ProductName", "Easnap"
            VALUE "ProductVersion", EASNAP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
