# Derive runtime dependencies from the real build graph, not a second test map.
get_property(test_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
set(runtime_manifest "[")
set(separator "")
foreach(test_target IN LISTS test_targets)
    get_target_property(target_type ${test_target} TYPE)
    if(NOT target_type STREQUAL "EXECUTABLE")
        continue()
    endif()
    set(runtime "")
    set(sources "")
    set(pending ${test_target})
    set(visited "")
    while(pending)
        list(POP_FRONT pending current)
        if(current IN_LIST visited OR NOT TARGET ${current})
            continue()
        endif()
        list(APPEND visited ${current})
        get_target_property(type ${current} TYPE)
        if(type STREQUAL "EXECUTABLE" AND NOT current STREQUAL test_target)
            list(APPEND runtime "\"$<TARGET_FILE:${current}>\"")
        endif()
        get_target_property(inputs ${current} SOURCES)
        get_target_property(source_dir ${current} SOURCE_DIR)
        if(inputs)
            foreach(input IN LISTS inputs)
                if(NOT input MATCHES "^\\$<")
                    get_filename_component(absolute "${input}" ABSOLUTE BASE_DIR "${source_dir}")
                    file(TO_CMAKE_PATH "${absolute}" absolute)
                    list(APPEND sources "\"${absolute}\"")
                endif()
            endforeach()
        endif()
        get_target_property(dependencies ${current} MANUALLY_ADDED_DEPENDENCIES)
        get_target_property(links ${current} LINK_LIBRARIES)
        foreach(dependency IN LISTS dependencies links)
            if(TARGET ${dependency})
                list(APPEND pending ${dependency})
            endif()
        endforeach()
    endwhile()
    list(REMOVE_DUPLICATES sources)
    list(JOIN sources "," sources_json)
    list(JOIN runtime "," runtime_json)
    string(APPEND runtime_manifest "${separator}{\"executable\":\"$<TARGET_FILE:${test_target}>\",\"runtime\":[${runtime_json}],\"sources\":[${sources_json}]}")
    set(separator ",\n")
endforeach()
string(APPEND runtime_manifest "]\n")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/easnap-test-inputs-$<CONFIG>.json" CONTENT "${runtime_manifest}")
