---
# Static analysis of apps/easnap-desktop/src (CI job "clang-tidy", required:
# any finding fails it). Turned off: checks that fire on Win32 idioms
# (HANDLE/LPARAM casts, GetProcAddress, message switches), narrowing, which
# MSVC /W4 already reports, and enum sizes, which touch persisted values.
# std::bad_array_new_length is ignored like std::bad_alloc: MSVC's allocation
# path throws it visibly, so every allocation in a noexcept function was
# reported. An empty catch that says "deliberately" in its comment is allowed.
Checks: >-
  -*,
  bugprone-*,
  performance-*,
  modernize-use-override,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-casting-through-void,
  -bugprone-switch-missing-default-case,
  -performance-no-int-to-ptr,
  -performance-enum-size
WarningsAsErrors: ''
HeaderFilterRegex: '.*[\\/]apps[\\/]easnap-desktop[\\/]src[\\/].*'
CheckOptions:
  bugprone-empty-catch.AllowEmptyCatchForExceptions: 'std::bad_alloc'
  bugprone-empty-catch.IgnoreCatchWithKeywords: '@TODO;@FIXME;deliberately'
  bugprone-exception-escape.IgnoredExceptions: 'bad_array_new_length'
